{
  "version": "9.0.0",
  "name": "@bcpros/bitcore",
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  },
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "private": true,
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "watch": "turbo run dev --parallel",
    "lint": "eslint .",
    "test": "turbo run test",
    "test:ci:local": "turbo run test",
    "test:bitcore-wallet-service": "turbo run test --filter=@bcpros/bitcore-wallet-service",
    "test:bitcore-wallet-client": "turbo run test --filter=@bcpros/bitcore-wallet-client",
    "test:bitcore-wallet": "turbo run test --filter=@bcpros/bitcore-wallet",
    "test:crypto-wallet-core": "turbo run test --filter=@bcpros/crypto-wallet-core",
    "test:bitcore-node": "turbo run test --filter=@bcpros/bitcore-node",
    "test:bitcore-lib": "turbo run test --filter=@bcpros/bitcore-lib",
    "test:bitcore-lib-cash": "turbo run test --filter=@bcpros/bitcore-lib-cash",
    "test:bitcore-lib-ltc": "turbo run test --filter=@bcpros/bitcore-lib-ltc",
    "test:bitcore-lib-doge": "turbo run test --filter=@bcpros/bitcore-lib-doge",
    "test:bitcore-lib-xec": "turbo run test --filter=@bcpros/bitcore-lib-xec",
    "test:bitcore-lib-xpi": "turbo run test --filter=@bcpros/bitcore-lib-xpi",
    "test:bitcore-p2p": "turbo run test --filter=@bcpros/bitcore-p2p",
    "test:bitcore-p2p-cash": "turbo run test --filter=@bcpros/bitcore-p2p-cash",
    "test:bitcore-p2p-xec": "turbo run test --filter=@bcpros/bitcore-p2p-xec",
    "test:bitcore-p2p-xpi": "turbo run test --filter=@bcpros/bitcore-p2p-xpi",
    "test:bitcore-p2p-doge": "turbo run test --filter=@bcpros/bitcore-p2p-doge",
    "test:bitcore-mnemonic": "turbo run test --filter=@bcpros/bitcore-mnemonic",
    "test:bitcore-client": "turbo run test --filter=@bcpros/bitcore-client",
    "build:bitcore-wallet-service": "turbo run build --filter=@bcpros/bitcore-wallet-service",
    "build:bitcore-wallet-client": "turbo run build --filter=@bcpros/bitcore-wallet-client",
    "build:bitcore-wallet": "turbo run build --filter=@bcpros/bitcore-wallet",
    "build:crypto-wallet-core": "turbo run build --filter=@bcpros/crypto-wallet-core",
    "build:bitcore-node": "turbo run build --filter=@bcpros/bitcore-node",
    "build:bitcore-lib": "turbo run build --filter=@bcpros/bitcore-lib",
    "build:bitcore-lib-cash": "turbo run build --filter=@bcpros/bitcore-lib-cash",
    "build:bitcore-lib-ltc": "turbo run build --filter=@bcpros/bitcore-lib-ltc",
    "build:bitcore-lib-doge": "turbo run build --filter=@bcpros/bitcore-lib-doge",
    "build:bitcore-lib-xec": "turbo run build --filter=@bcpros/bitcore-lib-xec",
    "build:bitcore-lib-xpi": "turbo run build --filter=@bcpros/bitcore-lib-xpi",
    "build:bitcore-p2p": "turbo run build --filter=@bcpros/bitcore-p2p",
    "build:bitcore-p2p-cash": "turbo run build --filter=@bcpros/bitcore-p2p-cash",
    "build:bitcore-p2p-xec": "turbo run build --filter=@bcpros/bitcore-p2p-xec",
    "build:bitcore-p2p-xpi": "turbo run build --filter=@bcpros/bitcore-p2p-xpi",
    "build:bitcore-p2p-doge": "turbo run build --filter=@bcpros/bitcore-p2p-doge",
    "build:bitcore-mnemonic": "turbo run build --filter=@bcpros/bitcore-mnemonic",
    "build:bitcore-client": "turbo run build --filter=@bcpros/bitcore-client",
    "fix:errors": "eslint --fix --quiet .",
    "fix:all": "eslint --fix .",
    "fix": "pnpm run fix:errors",
    "precommit": "eslint --pass-on-no-patterns --no-warn-ignored $(git diff --name-only --cached --diff-filter=AM)",
    "test:bitcore-logging": "turbo run test --filter=@bcpros/bitcore-logging",
    "build:bitcore-logging": "turbo run build --filter=@bcpros/bitcore-logging",
    "test:bitcore-tss": "turbo run test --filter=@bcpros/bitcore-tss",
    "build:bitcore-tss": "turbo run build --filter=@bcpros/bitcore-tss",
    "test:bitcore-cli": "turbo run test --filter=@bcpros/bitcore-cli",
    "build:bitcore-cli": "turbo run build --filter=@bcpros/bitcore-cli",
    "test:crypto-rpc": "turbo run test --filter=@bcpros/crypto-rpc",
    "build:crypto-rpc": "turbo run build --filter=@bcpros/crypto-rpc",
    "test:bitcore-build": "turbo run test --filter=@bcpros/bitcore-build",
    "build:bitcore-build": "turbo run build --filter=@bcpros/bitcore-build"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/node": "22.13.1",
    "browserify": "^16.2.3",
    "cz-customizable": "^5.2.0",
    "eight-colors": "^1.3.3",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "2.32.0",
    "globals": "^16.4.0",
    "husky": "^2.4.0",
    "lint-staged": "^9.5.0",
    "mocha": "11.7.5",
    "monocart-coverage-reports": "^2.13.0",
    "prettier": "^1.19.1",
    "ts-node": "^8.0.3",
    "turbo": "^2.4.0",
    "typedoc": "^0.15.0",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "typescript": "5.7.3"
  },
  "resolutions": {
    "ecashaddrjs": "npm:ecashaddrjs@^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "22.13.1"
    }
  },
  "husky": {
    "hooks": {}
  }
}

{
  "name": "@bcpros/crypto-wallet-core",
  "version": "9.0.9",
  "description": "A multi-currency support library for address derivation, private key creation, and transaction creation",
  "main": "./ts_build/src/index.js",
  "types": "./ts_build/src/index.d.ts",
  "files": [
    "ts_build"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bitpay/bitcore/tree/master/packages/crypto-wallet-core"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf ts_build && tsc --version",
    "compile": "pnpm run clean && pnpm run build",
    "lint": "eslint .",
    "fix:errors": "eslint --fix --quiet .",
    "fix:all": "eslint --fix .",
    "fix": "pnpm run fix:errors",
    "test": "pnpm run compile && mcr mocha ts_build/test",
    "pub": "pnpm run compile && npm publish",
    "precommit": "pnpm run fix"
  },
  "keywords": [
    "multi-currency",
    "addresses",
    "and",
    "transactions"
  ],
  "author": "Micah Riggan",
  "license": "MIT",
  "dependencies": {
    "@bcpros/bitcore-lib": "workspace:*",
    "@bcpros/bitcore-lib-cash": "workspace:*",
    "@bcpros/bitcore-lib-doge": "workspace:*",
    "@bcpros/bitcore-lib-ltc": "workspace:*",
    "@bcpros/bitcore-lib-xec": "workspace:*",
    "@bcpros/bitcore-lib-xpi": "workspace:*",
    "@solana-program/compute-budget": "0.7.0",
    "@solana-program/memo": "0.7.0",
    "@solana-program/system": "0.7.0",
    "@solana-program/token": "0.5.1",
    "@solana/kit": "2.1.0",
    "base-x": "^3.0.11",
    "ed25519-hd-key": "^1.3.0",
    "ethers": "6.13.5",
    "info": "0.0.6-beta.0",
    "ripple-binary-codec": "^1.10.0",
    "web3": "4.16.0",
    "web3-types": "^1.10.0",
    "xrpl": "2.13.0"
  },
  "devDependencies": {
    "@types/chai": "5.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.13.1",
    "chai": "5.1.2",
    "mocha": "11.1.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "web3-utils": "^4.3.3"
  },
  "gitHead": "e091d99915d099863ad3e78dbe867aa7780191e4"
}

{
  "name": "@bcpros/bitcore-wallet-service",
  "description": "A service for Mutisig HD Bitcoin Wallets",
  "author": "BitPay Inc",
  "version": "9.0.14",
  "license": "MIT",
  "main": "ts_build/src/index.js",
  "types": "./ts_build/src/index.d.ts",
  "keywords": [
    "bitcoin",
    "copay",
    "multisig",
    "wallet",
    "bitcore",
    "BWS"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bitpay/bitcore/tree/master/packages/bitcore-wallet-service"
  },
  "bugs": {
    "url": "https://github.com/bitpay/bitcore-wallet-service/issues"
  },
  "scripts": {
    "start": "pnpm run clean && pnpm run build && ./start.sh",
    "stop": "./stop.sh",
    "test": "pnpm run compile && mcr mocha ts_build/test",
    "build": "tsc && pnpm run cp:templates",
    "build:prod": "tsc -p tsconfig.prod.json && pnpm run cp:templates",
    "build:docker": "docker build -t bitpay/bitcore-wallet-service:latest -f ./Dockerfile ../..",
    "clean": "rm -rf ./ts_build",
    "compile": "pnpm run clean && pnpm run build",
    "pub": "pnpm run build && npm publish",
    "precommit": "pnpm run lint",
    "lint": "eslint .",
    "fix:errors": "eslint --fix --quiet .",
    "fix:all": "eslint --fix .",
    "fix": "pnpm run fix:errors",
    "update:stats": "pnpm run clean && pnpm run build && chmod +x ./ts_build/updatestats/updatestats.js && ./ts_build/updatestats/updatestats.js",
    "clean:fiatrates": "pnpm run clean && pnpm run build && chmod +x ./ts_build/cleanfiatrates/cleanfiatrates.js && ./ts_build/cleanfiatrates/cleanfiatrates.js",
    "cp:templates": "cp -r ./templates ./ts_build/templates",
    "start-debug": "pnpm run clean && pnpm run tsc && ./start.sh 1",
    "start-bws": "pnpm run clean && pnpm run tsc && ./start-bws.sh",
    "start-fiatrate": "pnpm run clean && pnpm run tsc && ./start-fiatrate.sh",
    "stop-bws": "./stop-bws.sh",
    "stop-fiatrate": "./stop-fiatrate.sh",
    "coverage": "npm run compile && ./node_modules/.bin/istanbul cover ./node_modules/.bin/_mocha -- --reporter spec test",
    "test:ci": "npm run test",
    "coveralls": "./node_modules/.bin/istanbul cover ./node_modules/mocha/bin/_mocha --report lcovonly -- -R spec && cat ./coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js && rm -rf ./coverage",
    "tsc": "npm run clean && tsc",
    "copy-csv": "mkdir ./ts_build/lib/csv && cp ./csv/* ./ts_build/lib/csv/"
  },
  "dependencies": {
    "@abcpros/xpi-js": "^4.0.5",
    "@bcpros/bitcore-lib": "workspace:*",
    "@bcpros/bitcore-lib-cash": "workspace:*",

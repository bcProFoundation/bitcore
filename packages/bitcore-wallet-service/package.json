    "@types/node": "22.19.15",
    "@types/nodemailer": "^4.6.6",
    "@types/request": "2.48.13",
    "@types/request-promise-native": "^1.0.15",
    "@types/secp256k1": "^4.0.7",
    "@types/sinon": "^22.0.0",
    "chai": "^5.2.0",
    "jsdoc": "^3.6.3",

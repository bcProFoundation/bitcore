{
  "name": "@bcpros/abcpay-wallet-service",
  "version": "1.0.0",
  "description": "AbcPay Wallet Service for eCash (XEC) and Dogecoin (DOGE) with Chronik and Postgres",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.json && mocha --timeout 15000 'test/**/*.test.js'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@bcpros/bitcore-lib-doge": "workspace:*",
    "@bcpros/bitcore-lib-xec": "workspace:*",
    "@prisma/client": "^6.16.2",
    "chronik-client": "^3.4.0",
    "fastify": "^5.2.1",
    "@fastify/cors": "^10.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "prisma": "^6.16.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "mocha": "11.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
